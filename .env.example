# Copy to .env in the repository root. Fill in your own values.
# Spring imports this file as Java properties: use KEY=value without surrounding quotes.
DB_URL=jdbc:mysql://localhost:3306/shopping
DB_USERNAME=shopping_user
DB_PASSWORD=
DB_DRIVER=com.mysql.cj.jdbc.Driver
DB_DDL_AUTO=update
# Generate a random secret of at least 48 bytes; never reuse the test fixture.
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRATION_MS=1800000
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000
JWT_REFRESH_COOKIE_NAME=refreshToken
JWT_REFRESH_COOKIE_PATH=/api/members
JWT_REFRESH_COOKIE_MAX_AGE_SECONDS=604800
JWT_REFRESH_COOKIE_SECURE=false
JWT_REFRESH_COOKIE_SAME_SITE=Lax
FRONTEND_ORIGIN=http://localhost:5173
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false
